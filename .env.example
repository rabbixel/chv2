# Creative Hatti — environment template
# Copy to `.env.local` for local development. Never commit real secrets.

# Public site URL (used for metadata, canonical links, sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL (leave empty while the mock service layer is active)
NEXT_PUBLIC_API_BASE_URL=

# Data source switch. "true" (default) uses the in-repo mock services in
# lib/services + data/. Flip to "false" once the real API is ready.
USE_MOCK_API=true

# Catalog pagination defaults (safe for the browser)
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=24

# --- Server-only settings (no NEXT_PUBLIC_ prefix) ---
# API_BASE_URL=
# REVALIDATE_CATALOG_SECONDS=3600
#
# Payment / storage secrets (Razorpay, AWS S3) are intentionally NOT part of
# this frontend. They must only ever live in the future backend service.
