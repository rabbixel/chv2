# Creative Hatti — environment template
# Copy to `.env.local` for local development. Never commit real secrets.

# Public site URL (used for metadata, canonical links, sitemaps)
NEXT_PUBLIC_SITE_URL=https://www.creativehatti.com

# Backend API base URL (leave empty while the mock service layer is active)
NEXT_PUBLIC_API_BASE_URL=

# "true" forces mock data. If unset or "false", the configured CH_API_URL
# supplies the catalogue, cart and checkout services.
USE_MOCK_API=true

# Authentication can be enabled independently while purchase history remains
# unavailable. Set to "wordpress" only after configuring the server bridge.
CH_AUTH_MODE=mock

# Catalog pagination defaults (safe for the browser)
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=24

## Razorpay is configured only in WordPress server environment; never add keys here.

# --- Server-only settings (no NEXT_PUBLIC_ prefix) ---
# Public WordPress catalogue API, including the indexed search plugin.
# Install wordpress/creative-hatti-search and build its index first.
CH_API_URL=
# Shared secret between Next.js and the WordPress auth endpoints. Generate a
# random value of at least 32 characters and configure it in both servers.
# This value is server-only and must never use a NEXT_PUBLIC_ prefix.
CH_AUTH_BRIDGE_SECRET=
# Frontend origin used by the server-side BFF for one-time claim links.
# Example locally: http://localhost:3000. Production must use HTTPS.
CH_AUTH_FRONTEND_URL=
# Public WordPress media origin. Production should use
# https://www.creativehatti.com (or https://creativehatti.com).
WORDPRESS_URL=https://www.creativehatti.com
# API_BASE_URL=
# REVALIDATE_CATALOG_SECONDS=3600
#
# Configure test credentials only on the WordPress server (wp-config.php or
# process environment): CH_RAZORPAY_TEST_KEY_ID and
# CH_RAZORPAY_TEST_KEY_SECRET. The Key ID must begin rzp_test_. Keep live mode
# disabled. Neither credential belongs in this frontend environment file.
# WordPress-side placeholders only; do not uncomment/copy into Next.js .env.local:
# CH_RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
# CH_RAZORPAY_TEST_KEY_SECRET=your_test_key_secret
